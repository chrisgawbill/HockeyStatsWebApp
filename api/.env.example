# ---------------------------------------------------------------------------
# Backend (Express API) environment variables.
# Copy this file to `api/.env` and fill in real values. Never commit `api/.env`.
# All values below are optional unless noted; defaults are shown where they apply.
# ---------------------------------------------------------------------------

# HTTP server
# Port the API listens on (see api/bin/www).
PORT=9000

# development | production
# In production, the AI subprocess uses system `python3` and DB SSL defaults on.
# In development, it uses api/venv/bin/python3.
NODE_ENV=development

# ---------------------------------------------------------------------------
# AI integration (team history endpoint, api/routes/hockey-ai.py)
# Required for /python-service to return data; without it the AI call fails.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# Claude model for the AI endpoint. Required: hockey-ai.py has no in-code
# default, so if this is unset the AI call fails.
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---------------------------------------------------------------------------
# Diagnostics (/health, /health/cache-usage)
# Passphrase sent in the `x-diagnostics-key` header. The check fails closed when
# unset (diagnostics return 401). Use a high-entropy value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
DIAGNOSTICS_PASSPHRASE=

# ---------------------------------------------------------------------------
# Caching (raw NHL response cache -> app_cache table)
# With no CACHE_DATABASE_URL the app uses local folders under api/cache/.
# With it set, the app defaults to Postgres.
# ---------------------------------------------------------------------------
CACHE_DATABASE_URL=
# 'true' forces SSL, 'false' disables it. Default: on when NODE_ENV=production.
CACHE_DATABASE_SSL=
# Connection/query timeout for the cache pool (ms). Default 5000.
CACHE_DATABASE_TIMEOUT_MS=5000
# Override the storage mode: filesystem | postgres | hybrid.
# Default: postgres when CACHE_DATABASE_URL is set, otherwise filesystem.
CACHE_STORAGE=

# ---------------------------------------------------------------------------
# Normalized domain persistence (seasons/teams/players/... tables)
# Migrations (`npm run db:migrate`) read CACHE_DATABASE_URL above.
# Domain backfills use DATABASE_URL, falling back to CACHE_DATABASE_URL.
# ---------------------------------------------------------------------------
DATABASE_URL=
# Query timeout for the domain pool (ms). Default 5000.
DATABASE_TIMEOUT_MS=5000
# Set to 'true' to skip normalized-table backfills while keeping the raw cache.
DISABLE_DOMAIN_PERSISTENCE=

# CA certificate used to verify the Postgres server's TLS cert. REQUIRED
# whenever SSL is enabled (NODE_ENV=production or CACHE_DATABASE_SSL=true) —
# getSslConfig() throws without it (fail-closed) rather than skipping
# verification. Accepts either the PEM text itself (paste the full
# -----BEGIN CERTIFICATE-----...-----END CERTIFICATE----- block, e.g. in a
# Render env var) or a path to a .pem file on disk. Neon chains to Let's
# Encrypt's ISRG Root X1 (https://letsencrypt.org/certs/isrgrootx1.pem).
DATABASE_CA_CERT=
