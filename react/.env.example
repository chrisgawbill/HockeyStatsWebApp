# ---------------------------------------------------------------------------
# Frontend (Vite) environment variables.
# Copy this file to `react/.env` (or .env.local) and adjust as needed.
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# ---------------------------------------------------------------------------

# Origin of the Express backend API.
# Defaults to http://localhost:9000 when unset (see src/lib/axiosInstance.ts).
VITE_API_URL=http://localhost:9000

# Google OAuth 2.0 Client ID for the optional site-wide "Sign in with Google"
# (favorite teams, After Action Reports, Rink Quest streak sync). Public by
# design (client IDs are not secret). Must match the API's
# GOOGLE_OAUTH_CLIENT_ID (HockeyStatsAPI/.env.example). Without it,
# GoogleSignInButton renders a disabled "Sign-in unavailable" state.
VITE_GOOGLE_CLIENT_ID=

# Discord OAuth2 Client ID (Discord Developer Portal) for "Sign in with
# Discord". Public by design. Must match the API's DISCORD_CLIENT_ID. Discord
# sends the user back to the app root (e.g. http://localhost:5173/HockeyStatsWebApp/,
# no `#` fragment), which must be in the API's DISCORD_REDIRECT_URIS and under
# OAuth2 -> Redirects in the portal.
VITE_DISCORD_CLIENT_ID=
