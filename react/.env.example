# ---------------------------------------------------------------------------
# Frontend (Vite) environment variables.
# Copy this file to `react/.env` (or .env.local) and adjust as needed.
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# ---------------------------------------------------------------------------

# Origin of the Express backend API.
# Defaults to http://localhost:9000 when unset (see src/lib/axiosInstance.ts).
VITE_API_URL=http://localhost:9000

# Google OAuth 2.0 Client ID for the board game's optional "Sign in with
# Google" streak sync (BG-B31). Public by design (client IDs are not secret).
# Must match the API's GOOGLE_OAUTH_CLIENT_ID (HockeyStatsAPI/.env.example). Without
# it, GoogleSignInButton renders a disabled "Sign-in unavailable" state.
VITE_GOOGLE_CLIENT_ID=
