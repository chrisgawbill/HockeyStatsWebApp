# ---------------------------------------------------------------------------
# Frontend (Vite) environment variables.
# Copy this file to `react/.env` (or .env.local) and adjust as needed.
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# ---------------------------------------------------------------------------

# Origin of the Express backend API.
# Defaults to http://localhost:9000 when unset (see src/lib/axiosInstance.ts).
VITE_API_URL=http://localhost:9000
